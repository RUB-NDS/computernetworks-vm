#!/usr/bin/env bash
set -euo pipefail

REPO_URL="{{ repo_url }}"
BRANCH="{{ repo_branch }}"
STATE_DIR="/var/lib/kali-setup"
REPO_DIR="$STATE_DIR/repo"
LOG_FILE="/var/log/kali-setup-update.log"
SETUP_USER="{{ setup_user }}"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"; }

log "Kali Setup Update gestartet"

# --- Repository klonen (immer frisch, shallow clone ist klein) ---
rm -rf "$REPO_DIR"
log "Klone Repository (Branch: $BRANCH)..."
mkdir -p "$STATE_DIR"
git clone -b "$BRANCH" --depth 1 "$REPO_URL" "$REPO_DIR"

# --- Playbook ausfuehren (ohne Cleanup) ---
log "Starte Playbook..."
ANSIBLE_FORCE_COLOR=1 ansible-playbook \
    -i "$REPO_DIR/ansible/inventory.yml" \
    "$REPO_DIR/ansible/playbook.yml" \
    --extra-vars "setup_user=$SETUP_USER" \
    --skip-tags cleanup \
    2>&1 | tee -a "$LOG_FILE"

log "Update abgeschlossen."
