[req]
default_bits       = 2048
distinguished_name = req_distinguished_name
req_extensions     = req_ext
prompt             = no

[req_distinguished_name]
C  = DE
ST = NRW
O  = {{ course_org }}
CN = localhost

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
{% for domain in course_domains %}
DNS.{{ loop.index + 1 }} = {{ domain }}
{% endfor %}
IP.1  = 127.0.0.1
